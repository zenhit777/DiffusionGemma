# HUGGINGFACE
HF_TOKEN=hf_***
# Doit pointer vers le cache HF sur la partition Windows (montage 9p/drvfs).
HF_HOME=/mnt/***

# MODEL
# Checkpoint NVFP4 (4 bits) : ~17 Go, tient dans 32 Go de VRAM.
# Le checkpoint BF16 officiel (google/diffusiongemma-26B-A4B-it) exige 64 Go.
HF_MODEL="RedHatAI/diffusiongemma-26B-A4B-it-NVFP4"

# Intervalle d'emission des metriques de debit dans les logs vLLM (secondes).
# La metrique "Committed token throughput" = tokens commites / fenetre.
VLLM_LOG_STATS_INTERVAL=10
