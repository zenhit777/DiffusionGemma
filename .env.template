# HUGGINGFACE
HF_TOKEN=hf_***
# Doit pointer vers le cache HF sur la partition Windows (montage 9p/drvfs).
HF_HOME=/mnt/***

# MODEL
# Checkpoint NVFP4 (4 bits) : 18 Go, tient dans 32 Go de VRAM.
# Alternative testee et plus lente : cyankiwi/diffusiongemma-26B-A4B-it-AWQ-INT4
#   (17,2 Go, 1215 tok/s contre 1525 tok/s a configuration identique).
# Le checkpoint BF16 officiel (google/diffusiongemma-26B-A4B-it) exige 64 Go.
#
# IMPORTANT : les poids du checkpoint choisi doivent etre presents dans
# $HF_HOME/hub/ avant de demarrer. Un bind-mount ne protege pas les fichiers
# telecharges dans la couche overlay du conteneur.
HF_MODEL="RedHatAI/diffusiongemma-26B-A4B-it-NVFP4"

# Intervalle d'emission des metriques de debit dans les logs vLLM (secondes).
# La metrique "Committed token throughput" = tokens commites / fenetre.
VLLM_LOG_STATS_INTERVAL=10

# Taille maximale de la fenêtre contextuelle
MAX_LENGH=131072